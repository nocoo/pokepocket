{
  "name": "pokepocket",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/setup-emulator.mjs && node scripts/check-no-roms.mjs public && npm run typecheck && vite build && node scripts/check-no-roms.mjs dist",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "cf:typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:http": "vitest run --config vitest.http.config.ts",
    "test:e2e": "node scripts/run-l3.mjs",
    "postinstall": "node scripts/setup-emulator.mjs",
    "rom:build": "node scripts/build-rom.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "biome lint --error-on-warnings",
    "quality:g1": "npm run lint && npm run typecheck && npm run format:check",
    "check:distribution": "node scripts/check-no-roms.mjs public dist",
    "verify:access": "node scripts/verify-access.mjs",
    "verify:release": "node scripts/verify-access.mjs --release",
    "quality:l1": "vitest run --coverage",
    "quality:g2": "node scripts/run-g2.mjs",
    "quality:commit": "node scripts/run-parallel.mjs",
    "prepare": "husky",
    "quality:l2": "node scripts/run-l2.mjs",
    "quality:push": "node scripts/run-push.mjs",
    "test:e2e:optional": "node scripts/run-l3-optional.mjs",
    "quality:l3": "node scripts/run-l3.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@thenick775/mgba-wasm": "2.5.1",
    "idb": "8.0.4",
    "jose": "6.2.12",
    "lucide-react": "1.55.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/vite-plugin": "1.63.1",
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.12.0",
    "husky": "9.1.7",
    "js-yaml": "4.3.2",
    "miniflare": "5.20261006.1-alpha",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.4",
    "wrangler": "4.145.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nocoo/pokepocket.git"
  },
  "overrides": {
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
